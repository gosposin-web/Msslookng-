ADMIN_PASSWORD=replace-with-a-long-unique-password
APP_ENCRYPTION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATA_DIR=/var/data/story-cloud
COOKIE_SECURE=true
# Optional: configure your own Telegram app here, or enter its credentials in the import form.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: exact external origin, without trailing slash.
PUBLIC_ORIGIN=

